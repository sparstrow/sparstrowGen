{
  "name": "@sparstrow/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./routes": "./src/routes/index.ts"
  },
  "scripts": {
    "dev": "node --watch-path=src --import tsx src/index.ts",
    "start": "tsx src/index.ts",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:cli": "esbuild src/cli/setup.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/cli/setup.mjs --external:better-sqlite3 --external:node-pty --external:fastembed --external:sqlite-vec --external:pino --external:pino-pretty"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^9.1.1",
    "@fastify/websocket": "^11.1.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@sparstrow/shared": "workspace:*",
    "@supabase/realtime-js": "^2.112.4",
    "@supabase/supabase-js": "catalog:",
    "better-sqlite3": "^12.2.0",
    "chokidar": "^4.0.3",
    "croner": "^9.0.0",
    "drizzle-orm": "catalog:",
    "fastembed": "^1.14.1",
    "fastify": "^5.3.3",
    "js-yaml": "^4.1.2",
    "nanoid": "^5.1.5",
    "node-pty": "^1.0.0",
    "pino": "^9.7.0",
    "postgres": "catalog:",
    "sqlite-vec": "^0.1.6",
    "tree-kill": "^1.2.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "catalog:",
    "esbuild": "^0.25.12",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@sparstrow/tsconfig": "workspace:*"
  },
  "bin": {
    "sparstrow": "./dist/cli/setup.mjs"
  }
}
