# Sparstrowgen Environment Configuration (Supabase & Multi-Daemon)

# Supabase PostgreSQL Connection URI (Database -> Settings -> Connection String -> URI)
# Example: postgres://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgres://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Supabase Project URL (Project Settings -> API -> Project URL)
# Example: https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Supabase Anon Public Key (Project Settings -> API -> Project API keys -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"

# Supabase Service Role Secret Key (Project Settings -> API -> Project API keys -> service_role secret)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY"

# SUPABASE_JWT_SIGNING_KEY was here (M16). REMOVED by T-DI-03 -- do not re-add.
# It asked for the project's private ES256 signing key, which Supabase never
# exposes: the dashboard only ever shows the public JWKS, for the current key
# and for a freshly created one alike. A daemon's Realtime credential is now a
# real Supabase session minted through the Auth admin API, so there is no
# signing key for this app to hold at all.
# See doc/plans/2026-08-27-the-daemon-gets-a-real-identity.md.

# Node Environment
NODE_ENV="development"
