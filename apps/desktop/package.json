{
  "name": "@sparstrow/desktop",
  "productName": "Sparstrowgen",
  "version": "0.3.4",
  "private": true,
  "description": "Sparstrowgen desktop shell",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "dist:prepare": "node scripts/prepare-resources.mjs dev",
    "dist": "pnpm dist:dev",
    "dist:stable": "pnpm build && node scripts/prepare-resources.mjs stable && node scripts/build-channel-config.mjs stable && node scripts/ensure-draft-release.mjs stable && electron-builder --win nsis --publish always --config electron-builder.stable.generated.json",
    "dist:dev": "pnpm build && node scripts/prepare-resources.mjs dev && node scripts/build-channel-config.mjs dev && electron-builder --win nsis --publish never --config electron-builder.dev.generated.json"
  },
  "devDependencies": {
    "@sparstrow/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^7.0.0",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@sparstrow/core": "workspace:*",
    "@sparstrow/shared": "workspace:*",
    "@sparstrow/ui": "workspace:*",
    "@sparstrow/views": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "electron-updater": "^6.6.2",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "build": {
    "appId": "com.sparstrow.sparstrowgen",
    "productName": "Sparstrowgen",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources-staging/core",
        "to": "core",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources-staging/memory-mcp",
        "to": "memory-mcp",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources-staging/memory-cli",
        "to": "memory-cli",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources-staging/node-runtime",
        "to": "node-runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources-staging/channel.json",
        "to": "channel.json"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "sparstrow",
      "repo": "sparstrowGen"
    }
  }
}
