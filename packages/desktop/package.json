{
  "name": "@sparstrow/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Sparstrowgen desktop shell",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.sparstrow.sparstrowgen",
    "productName": "Sparstrowgen",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    }
  }
}
