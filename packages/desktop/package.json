{
  "name": "@sparstrow/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Sparstrowgen desktop shell",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist:prepare": "node scripts/prepare-resources.mjs",
    "dist": "npm run build && npm run dist:prepare && electron-builder --win nsis",
    "dist:publish": "npm run build && npm run dist:prepare && electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "com.sparstrow.sparstrowgen",
    "productName": "Sparstrowgen",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      { "from": "resources-staging/core", "to": "core" },
      { "from": "resources-staging/ui", "to": "ui" },
      { "from": "resources-staging/memory-mcp", "to": "memory-mcp" },
      { "from": "resources-staging/memory-cli", "to": "memory-cli" },
      { "from": "resources-staging/node-runtime", "to": "node-runtime" }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "sparstrow",
      "repo": "sparstrowGen"
    }
  }
}
