{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src"],
  // Tests are run by vitest, never compiled. Without this they land in dist/,
  // and electron-builder ships dist/**/* into the packaged app.
  "exclude": ["src/**/*.test.ts"]
}
